{
  "name": "raylibextension",
  "displayName": "raylibextension",
  "description": "Raylib Oficial VScode Extension",
  "version": "0.0.1",
  "icon": "resources/Raylib_logo.png",
  "engines": {
    "vscode": "^1.125.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "raylibextension.createproject",
        "title": "Create Raylib Project"
      },
      {
        "command": "raylibextension.build",
        "title": "Build Raylib Project"
      },
      {
        "command": "raylibextension.clean",
        "title": "Clean Raylib Project"
      },
      {
        "command": "raylibextension.rebuild",
        "title": "Rebuild Raylib Project"
      },
      {
        "command": "raylibextension.compileandrun",
        "title": "Compile and Run Raylib Project"
      },
      {
        "command": "raylibextension.buildwithextra",
        "title": "Build with params"
      }
    ],
    "configuration":[
      {
        "title": "Raylib Extension",
        "properties": {
          "raylib.mingwpath":{
            "title": "Mingw Installation Path",
            "type": "string",
            "default": "",
            "description": "MinGW Binaries Installation Path"
          },
          "raylib.rpcpath":{
            "title": "Raylib Project Creator path",
            "type": "string",
            "default":"",
            "description": "Raylib Project Creator path"
          },
          "raylib.compilethreads":{
            "title": "Number of Compile Threads",
            "type": "number",
            "default": 1,
            "description": "-J Parameter when calling Make"
          },
          "raylib.extrabuildparams":{
            "title": "Extra Parameters when Build",
            "type": "string",
            "default": "",
            "description": "Extra parameters when call make (To All calls)"
          }
        }
      }

    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test --label Mistests"
  },
  "devDependencies": {
    "@types/vscode": "^1.125.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "typescript-eslint": "^8.61.1",
    "eslint": "^10.5.0",
    "typescript": "^6.0.3",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
